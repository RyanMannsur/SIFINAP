# Etapa 1: Build do Frontend Angular
FROM node:22-alpine AS frontend-build
WORKDIR /app/frontend
COPY fontes/frontend/package*.json ./
RUN npm install
COPY fontes/frontend/ ./
RUN npm run build -- --configuration production

# Etapa 2: Build do Backend Spring Boot (incluindo o Frontend estático)
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /app

# Copia arquivos do Maven
COPY fontes/backend/pom.xml .
COPY fontes/backend/mvnw .
COPY fontes/backend/.mvn .mvn
COPY fontes/backend/src src

# Copia o build estático do Angular para a pasta static do Spring Boot
COPY --from=frontend-build /app/frontend/dist/frontend/browser src/main/resources/static

# Realiza o build do JAR único
RUN chmod +x mvnw && ./mvnw clean package -DskipTests

# Etapa 3: Imagem final de execução
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar

EXPOSE 10000
ENTRYPOINT ["java", "-jar", "app.jar"]
